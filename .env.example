# NOTE: the handful of REQUIRED, secret-shaped values (APP_ENV, APP_PORT,
# DATABASE_URL, JWT_SECRET, BOOTSTRAP_ADMIN_*, SSH_CREDENTIAL_ENCRYPTION_KEY)
# no longer live in a plaintext .env -- they moved to
# development.ini/production.ini, with every actual secret value AES-256-GCM
# encrypted (see internal/config/encrypted_env.go's doc comment for why).
# This file remains the full reference for every OPTIONAL tuning variable
# below -- none of these are secret (timeouts, worker counts, thresholds),
# so they're still plain OS environment variables/.env overrides if you
# ever need to change one from its built-in default; most deployments
# never will.

# Optional connection pool tuning (defaults shown)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT_SECONDS=5

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Optional auth tuning (defaults shown)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE defaults to false when APP_ENV=development, true otherwise.
# Uncomment to override either way:
# COOKIE_SECURE=false

# SSH_CREDENTIAL_ENCRYPTION_KEY (the AES-256 key that encrypts SSH private
# keys before they ever reach PostgreSQL) now lives in
# development.ini/production.ini, ENC(...)-wrapped -- see the note at the
# top of this file. Generate one with: go run ./cmd/gen-encryption-key

# Optional SSH tuning (defaults shown)
SSH_CONNECT_TIMEOUT=10s
SSH_COMMAND_TIMEOUT=30s

# VM monitoring (Step 6) -- defaults shown, see docs/vm-monitoring.md
VM_MONITOR_INTERVAL=60s
VM_MONITOR_WORKERS=5
VM_MONITOR_STALE_AFTER=5m
VM_MONITOR_RETENTION_DAYS=30
VM_CPU_WARNING_PERCENT=80
VM_CPU_CRITICAL_PERCENT=90
VM_MEMORY_WARNING_PERCENT=80
VM_MEMORY_CRITICAL_PERCENT=90
VM_DISK_WARNING_PERCENT=80
VM_DISK_CRITICAL_PERCENT=90

# Linux package discovery/updates (Step 7) -- defaults shown, see
# docs/package-management.md
PACKAGE_SCAN_INTERVAL=6h
PACKAGE_SCAN_WORKERS=2
PACKAGE_SCAN_COMMAND_TIMEOUT=90s

# Docker discovery/inventory/metrics (Step 8) -- defaults shown, see
# docs/docker-monitoring.md. Three independent cadences, never combined:
# DOCKER_SCAN_INTERVAL is inventory (slow), DOCKER_METRICS_INTERVAL is
# container stats collection (fast), DOCKER_STATS_STREAM_INTERVAL is only
# the WebSocket push cadence and never triggers its own collection.
DOCKER_SCAN_INTERVAL=10m
DOCKER_SCAN_WORKERS=2
DOCKER_METRICS_INTERVAL=15s
DOCKER_METRICS_WORKERS=3
DOCKER_STATS_STREAM_INTERVAL=1s
DOCKER_METRICS_RETENTION_DAYS=7
DOCKER_METRICS_STALE_AFTER=60s

# Update Center (Step 9) -- defaults shown, see docs/update-center.md.
# OS/kernel/reboot detection has no interval of its own -- it rides on
# PACKAGE_SCAN_INTERVAL above. This only controls the pre-update
# checklist's "package information may be stale" warning threshold.
UPDATE_METADATA_STALE_AFTER=1h

# Update execution engine (Step 10) -- defaults shown, see
# docs/update-execution.md. UPDATE_COMMAND_TIMEOUT is deliberately much
# longer than SSH_COMMAND_TIMEOUT above -- real package installs can take
# minutes, unlike the fixed, fast, read-only discovery commands.
UPDATE_WORKERS=2
MAX_CONCURRENT_UPDATES=2
MAX_PACKAGES_PER_UPDATE_PLAN=100
UPDATE_COMMAND_TIMEOUT=30m
UPDATE_LOG_MAX_BYTES=2097152

# Controlled VM reboot (Step 11) -- defaults shown, see docs/vm-reboot.md.
REBOOT_WORKERS=2
MAX_CONCURRENT_VM_OPERATIONS=3
REBOOT_TIMEOUT=10m
REBOOT_INITIAL_WAIT=10s
REBOOT_MAX_RECONNECT_ATTEMPTS=12

# Standalone database monitoring (Step 12/13, strictly read-only) -- defaults
# shown, see docs/database-monitoring.md and docs/database-performance.md.
# Discovery/fast-metrics/deep-metrics are three independent cadences, same
# reasoning as Docker's own three-way split above.
DATABASE_DISCOVERY_INTERVAL=10m
DATABASE_DISCOVERY_WORKERS=2
DATABASE_METRICS_INTERVAL=15s
DATABASE_METRICS_WORKERS=3
DATABASE_METRICS_RETENTION_DAYS=7
DATABASE_METRICS_STALE_AFTER=60s
DATABASE_CONNECTION_WARNING_PERCENT=80
DATABASE_CONNECTION_CRITICAL_PERCENT=95
DATABASE_MEMORY_WARNING_PERCENT=80
DATABASE_MEMORY_CRITICAL_PERCENT=95
DATABASE_CONNECTION_TIMEOUT=10s
DATABASE_QUERY_TIMEOUT=5s

# Advanced database performance monitoring (Step 13) -- its own, slower
# "deep" cycle layered on the fast one above: query rankings, locks/waits,
# replication detail, storage growth.
DATABASE_SLOW_QUERY_MS=1000
DATABASE_LONG_RUNNING_QUERY_SECONDS=60
DATABASE_QUERY_METRICS_RETENTION_DAYS=7
DATABASE_DEEP_METRICS_INTERVAL=60s
DATABASE_DEEP_METRICS_WORKERS=2
# Shared cap on simultaneous connections THIS application opens to target
# databases, across both the fast and deep cycles above combined.
DATABASE_MONITOR_MAX_CONNECTIONS=3
# Whether the slow-query ranking captures the query text itself (vs.
# fingerprint only) -- off by default since query text can incidentally
# contain sensitive literal values.
DATABASE_QUERY_TEXT_CAPTURE=false
DATABASE_QUERY_TEXT_MAX_BYTES=4096
DATABASE_CACHE_HIT_WARNING_PERCENT=95
DATABASE_CACHE_HIT_CRITICAL_PERCENT=90
DATABASE_LOCK_WARNING_COUNT=3
DATABASE_ALERT_COOLDOWN=15m
DATABASE_GROWTH_WARNING_PERCENT=20

# Controlled database operations + admin remediation (Step 14) -- defaults
# shown, see docs/database-operations.md. A small, closed set of backend-
# defined remediation templates (cancel query, terminate session, VACUUM/
# ANALYZE, kill client, background save) -- never arbitrary SQL/Redis/
# MongoDB/shell commands.
DATABASE_OPERATION_WORKERS=2
MAX_CONCURRENT_DATABASE_OPERATIONS=3
DATABASE_OPERATION_TIMEOUT=300s
DATABASE_OPERATION_LOG_MAX_BYTES=1048576

# Step 17: Object Storage (AWS S3 / DigitalOcean Spaces / MinIO / generic
# S3-compatible) -- defaults shown, see docs/object-storage.md. A standalone
# resource monitored directly over the S3 API (never a VM child, never SSH).
# Grouped below by concern, in the order a request/collection cycle actually
# uses them: connection probing, fast metrics, deep metrics + thresholds,
# then the read-only browser.

# Connection probing: bounds the one HeadBucket probe both
# POST .../test-connection and the fast cycle below run.
OBJECT_STORAGE_CONNECTION_TIMEOUT=10s

# Fast metrics: a HeadBucket-only reachability/latency probe, same
# cadence/worker-pool/connection-cap shape as the Database block above,
# never a ListObjectsV2 call.
OBJECT_STORAGE_METRICS_INTERVAL=60s
OBJECT_STORAGE_METRICS_WORKERS=3
OBJECT_STORAGE_METRICS_RETENTION_DAYS=30
OBJECT_STORAGE_METRICS_STALE_AFTER=5m
# Shared cap on simultaneous S3 connections across BOTH the fast and deep
# schedulers below (one limiter instance, not two independent ones).
OBJECT_STORAGE_MONITOR_MAX_CONNECTIONS=5

# Deep metrics: bucket security facts (versioning/encryption/public-access/
# object-lock), growth tracking, and CloudWatch bucket metrics for AWS S3 --
# plus the alert/recommendation thresholds computed from that data.
OBJECT_STORAGE_DEEP_METRICS_INTERVAL=5m
OBJECT_STORAGE_DEEP_METRICS_WORKERS=2
OBJECT_STORAGE_GROWTH_WARNING_PERCENT=20
OBJECT_STORAGE_ERROR_RATE_WARNING_PERCENT=5
# LOW/MEDIUM/HIGH/CRITICAL -- severity of the OBJECT_STORAGE_PUBLIC_ACCESS
# recommendation when a bucket is found to allow public access (no per-admin
# severity-policy mechanism exists, so this is a single global default; an
# unrecognized value normalizes to HIGH rather than failing the insert).
OBJECT_STORAGE_PUBLIC_ACCESS_SEVERITY=CRITICAL

# Object storage browser: read-only object listing/prefix navigation,
# metadata, short-lived presigned-URL download, and text/JSON preview. No
# write/delete/upload S3 call exists anywhere in this feature.
# OBJECT_STORAGE_MAX_PAGE_SIZE is the server-enforced upper bound on a
# listing/search page size regardless of what the client requests.
# OBJECT_STORAGE_DOWNLOAD_URL_TTL bounds how long a presigned download URL
# stays valid. OBJECT_STORAGE_PREVIEW_MAX_BYTES caps how much of an object
# the preview endpoint will ever read into memory.
OBJECT_STORAGE_MAX_PAGE_SIZE=200
OBJECT_STORAGE_DOWNLOAD_URL_TTL=5m
OBJECT_STORAGE_PREVIEW_MAX_BYTES=5242880

# Central alerts + notifications (Step 16) -- defaults shown, see
# docs/alerts.md. Metrics -> Rule Evaluation -> Threshold -> Duration ->
# Deduplication -> Alert State -> Notification.
ALERT_EVAL_INTERVAL=30s
ALERT_STREAM_INTERVAL=15s
# Minimum time between repeat notifications for the same still-open alert
# (deduplication keeps re-evaluation from creating a new alert row; this
# additionally keeps it from re-notifying every single evaluation cycle).
ALERT_NOTIFICATION_COOLDOWN=15m
ALERT_NOTIFICATION_MAX_RETRIES=3
ALERT_WEBHOOK_TIMEOUT=10s
ALERT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90

# Log archiving -- an optional extra step every Docker/K8s/Docker-Host log
# retention sweep runs right before deleting rows older than its own
# retention window (DOCKER_LOG_RETENTION_DAYS/K8S_LOG_RETENTION_DAYS
# above), writing them out somewhere durable first instead of just losing
# them. See internal/services/log_archive.go. Fully configured in
# development.ini.enc/production.ini.enc's own [log-archive] section
# instead of here (LOG_ARCHIVE_BACKEND/_VOLUME_PATH/_S3_BUCKET/_REGION/
# _ENDPOINT/_PREFIX/_ACCESS_KEY_ID/_SECRET_ACCESS_KEY) -- nothing to set
# in this file for it.

# HTTP hardening (Step 20) -- defaults shown, see docs/security-hardening.md.
# MAX_REQUEST_BODY_BYTES bounds every request body (this project has no file
# upload endpoint; every JSON payload is small). LOGIN_RATE_LIMIT_ATTEMPTS
# per LOGIN_RATE_LIMIT_WINDOW bounds POST /api/auth/login attempts per
# source IP, mitigating credential stuffing/brute force.
MAX_REQUEST_BODY_BYTES=2097152
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=5m

# SMTP (outbound email): used for both alert notifications (EMAIL channel)
# and new-user invite emails. Leave SMTP_HOST blank to disable email
# delivery entirely -- alert notifications marked FAILED with a clear
# reason, invite emails silently skipped (the temporary password is still
# shown/returned on-screen either way, so inviting never depends on this).
# SMTP_USE_TLS=true selects implicit TLS (typically port 465); false uses
# opportunistic STARTTLS on a plain connection (typically port 587/25).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@infrahub.local
SMTP_USE_TLS=false
SMTP_TIMEOUT=10s

# The frontend's own externally-reachable URL -- used only to build the
# "sign in here" link in a new user's invite email.
APP_BASE_URL=http://localhost:3000

# OAuth login (GitHub/Google), invite-only: signing in only succeeds for
# an email that already has an admin-created account -- never
# auto-registers a new one. Leave a provider's CLIENT_ID/SECRET blank to
# disable it entirely (its "Continue with..." button won't be shown).
# Register the OAuth app's callback/redirect URL as exactly:
#   {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/github/callback
#   {OAUTH_REDIRECT_BASE_URL}/api/auth/oauth/google/callback
# OAUTH_REDIRECT_BASE_URL must be THIS BACKEND's own externally-reachable
# origin (not APP_BASE_URL, the frontend's) -- the browser talks to this
# backend directly, with no frontend proxy in front of /api/*.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
